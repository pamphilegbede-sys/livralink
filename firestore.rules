rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // 0. Global Safety Net: Default-deny catch-all
    // -------------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Helper Primitives & Attribute-Based Access Control (ABAC)
    // -------------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function hasVerifiedEmail() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-#]+$');
    }

    // Strict Super-Admin & Authorized Admin Check (requires verified email)
    function isSuperAdmin() {
      return hasVerifiedEmail() &&
             request.auth.token.email != null &&
             request.auth.token.email.matches('(?i)^pamphile\\.gbede@gmail\\.com$');
    }

    function isAdmin() {
      return hasVerifiedEmail() && (
        isSuperAdmin() ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isVendeur() {
      return hasVerifiedEmail() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'vendeur';
    }

    function isLivreur() {
      return hasVerifiedEmail() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'livreur';
    }

    function isKycVerifiedLivreur() {
      return isLivreur() &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isKycVerified == true;
    }

    function isClient() {
      return hasVerifiedEmail() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'client';
    }

    // Safe Courier Assignment Helpers (supports both courierId and courier.id without trusting empty strings)
    function hasValidCourierId(data) {
      return (
        ('courierId' in data && data.courierId is string && data.courierId.size() >= 1 && data.courierId.size() <= 128) ||
        ('courier' in data && data.courier is map && 'id' in data.courier && data.courier.id is string && data.courier.id.size() >= 1 && data.courier.id.size() <= 128)
      );
    }

    function getCourierId(data) {
      return ('courierId' in data && data.courierId is string && data.courierId.size() >= 1)
        ? data.courierId
        : (('courier' in data && data.courier is map && 'id' in data.courier && data.courier.id is string && data.courier.id.size() >= 1)
            ? data.courier.id
            : '');
    }

    function noCourierAssigned(data) {
      return !('courierId' in data) &&
             (!('courier' in data) || !(data.courier is map) || !('id' in data.courier));
    }

    // -------------------------------------------------------------------------
    // User Blueprint Validation (Anti-Privilege Escalation & Legacy-Safe Updates)
    // -------------------------------------------------------------------------
    function isValidUserTypes(data) {
      return data.keys().hasAll(['uid', 'email', 'fullName', 'phone', 'role']) &&
             data.uid == request.auth.uid &&
             data.email is string && data.email.size() >= 5 && data.email.size() <= 128 &&
             data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 128 &&
             data.phone is string && data.phone.size() <= 32 &&
             data.role in ['client', 'vendeur', 'livreur'] &&
             (!('status' in data) || data.status in ['actif', 'en_ligne', 'hors_ligne', 'en_attente_kyc', 'en_course', 'suspendu']) &&
             (!('isKycVerified' in data) || data.isKycVerified is bool) &&
             (!('kycStatus' in data) || data.kycStatus in ['non_soumis', 'en_attente', 'valide', 'refuse']) &&
             (!('preferredRateDiscountPercent' in data) || data.preferredRateDiscountPercent is number) &&
             (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 1000)) &&
             (!('storeName' in data) || (data.storeName is string && data.storeName.size() <= 128)) &&
             (!('storeCommune' in data) || (data.storeCommune is string && data.storeCommune.size() <= 128)) &&
             (!('storeAddress' in data) || (data.storeAddress is string && data.storeAddress.size() <= 256)) &&
             (!('vehicleType' in data) || (data.vehicleType is string && data.vehicleType.size() <= 64)) &&
             (!('gpsCoordinates' in data) || (data.gpsCoordinates is string && data.gpsCoordinates.size() <= 64)) &&
             (!('locationCommune' in data) || (data.locationCommune is string && data.locationCommune.size() <= 128)) &&
             (!('locationAddress' in data) || (data.locationAddress is string && data.locationAddress.size() <= 256)) &&
             (!('locationLat' in data) || (data.locationLat is number)) &&
             (!('locationLng' in data) || (data.locationLng is number)) &&
             (!('locationUpdatedAt' in data) || (data.locationUpdatedAt is string && data.locationUpdatedAt.size() <= 64)) &&
             (!('mfaEnabled' in data) || (data.mfaEnabled is bool));
    }

    function isValidUserOnCreate(data) {
      return isValidUserTypes(data) &&
             (!('status' in data) || data.status in ['actif', 'en_ligne', 'hors_ligne', 'en_attente_kyc']) &&
             (!('isKycVerified' in data) || data.isKycVerified == false) &&
             (!('kycStatus' in data) || data.kycStatus in ['non_soumis', 'en_attente']) &&
             (!('preferredRateDiscountPercent' in data) || data.preferredRateDiscountPercent == 0) &&
             data.keys().hasOnly([
               'uid', 'email', 'fullName', 'phone', 'role', 'status', 'channel',
               'preferredRateDiscountPercent', 'avatarUrl',
               'storeName', 'storeCommune', 'storeAddress', 'storeCoordinates',
               'vehicleType', 'gpsCoordinates', 'locationCommune', 'locationAddress',
               'locationLat', 'locationLng', 'locationUpdatedAt',
               'isKycVerified', 'kycStatus', 'kycRejectionReason', 'kycSubmittedAt',
               'mfaEnabled', 'mfaMethod',
               'createdAt', 'updatedAt'
             ]);
    }

    // -------------------------------------------------------------------------
    // Delivery Blueprint Validation & Strict Status Machine
    // -------------------------------------------------------------------------
    function isValidDelivery(data) {
      return data.keys().hasAll(['id', 'clientName', 'clientPhone', 'status', 'deliveryFee', 'merchantId']) &&
             !('otpCode' in data) &&
             data.id is string && data.id.size() >= 1 && data.id.size() <= 64 &&
             data.clientName is string && data.clientName.size() >= 1 && data.clientName.size() <= 128 &&
             data.clientPhone is string && data.clientPhone.size() <= 32 &&
             data.merchantId is string && data.merchantId.size() >= 1 && data.merchantId.size() <= 128 &&
             data.deliveryFee is number && data.deliveryFee >= 0 &&
             data.status in ['en_attente', 'assignee', 'acceptee', 'colis_recupere', 'en_cours', 'livree', 'echec'] &&
             (!('itemValueCOD' in data) || (data.itemValueCOD is number && data.itemValueCOD >= 0)) &&
             (!('courierId' in data) || (data.courierId is string && data.courierId.size() >= 1 && data.courierId.size() <= 128)) &&
             (!('courierName' in data) || (data.courierName is string && data.courierName.size() <= 128)) &&
             (!('otpRequired' in data) || data.otpRequired is bool);
    }

    function isCourierStatusTransition(oldStatus, newStatus) {
      // Couriers advance through pickup and transit, or report failure.
      // Transition to 'livree' is strictly performed server-side after OTP & Storage verification (or by Admin).
      return ((oldStatus in ['assignee', 'acceptee']) && newStatus in ['colis_recupere', 'echec']) ||
             (oldStatus == 'colis_recupere' && newStatus in ['en_cours', 'echec']) ||
             (oldStatus == 'en_cours' && newStatus == 'echec');
    }

    // -------------------------------------------------------------------------
    // Notification Blueprint Validation
    // -------------------------------------------------------------------------
    function isValidNotification(data) {
      return data.keys().hasAll(['id', 'recipientId', 'senderId', 'title', 'message']) &&
             isValidId(data.id) &&
             isValidId(data.recipientId) &&
             data.senderId is string &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 256 &&
             data.message is string && data.message.size() >= 1 && data.message.size() <= 2048;
    }

    // -------------------------------------------------------------------------
    // KYC Dossier Blueprint Validation
    // -------------------------------------------------------------------------
    function isValidKYCDossier(data) {
      return data.keys().hasAll(['id', 'userId', 'fullName', 'phone', 'status']) &&
             isValidId(data.id) &&
             isValidId(data.userId) &&
             data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 128 &&
             data.phone is string && data.phone.size() <= 32 &&
             data.status in ['en_attente', 'valide', 'refuse'] &&
             (!('isApproved' in data) || data.isApproved == false || isAdmin()) &&
             (!('verified' in data) || data.verified == false || isAdmin());
    }

    // -------------------------------------------------------------------------
    // Conversation Blueprint Validation
    // -------------------------------------------------------------------------
    function isValidConversation(data) {
      return data.keys().hasAll(['participantIds']) &&
             data.participantIds is list &&
             data.participantIds.size() >= 2 &&
             data.participantIds.size() <= 10 &&
             data.participantIds[0] is string &&
             data.participantIds[1] is string;
    }

    // -------------------------------------------------------------------------
    // 1. Users Collection (/users)
    // -------------------------------------------------------------------------
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId) && (isAdmin() || (isOwner(userId) && isValidUserOnCreate(incoming())));
      allow update: if isValidId(userId) && (
        isAdmin() ||
        (
          isOwner(userId) &&
          isValidUserTypes(incoming()) &&
          (!('uid' in existing()) || existing().uid == '' || incoming().uid == existing().uid) &&
          incoming().uid == userId &&
          (!('email' in existing()) || existing().email == '' || incoming().email == existing().email) &&
          (!('email' in incoming().diff(existing()).affectedKeys()) || (
            (!('email' in existing()) || existing().email == '') &&
            request.auth.token.email != null &&
            incoming().email == request.auth.token.email
          )) &&
          (!('role' in existing()) || existing().role == '' || incoming().role == existing().role) &&
          (!('role' in incoming().diff(existing()).affectedKeys()) || (
            (!('role' in existing()) || existing().role == '') &&
            incoming().role in ['client', 'vendeur', 'livreur']
          )) &&
          (!('status' in incoming()) || ('status' in existing() && incoming().status == existing().status)) &&
          (!('isKycVerified' in incoming()) || ('isKycVerified' in existing() && incoming().isKycVerified == existing().isKycVerified) || (!('isKycVerified' in existing()) && incoming().isKycVerified == false)) &&
          (!('preferredRateDiscountPercent' in incoming()) || ('preferredRateDiscountPercent' in existing() && incoming().preferredRateDiscountPercent == existing().preferredRateDiscountPercent) || (!('preferredRateDiscountPercent' in existing()) && incoming().preferredRateDiscountPercent == 0)) &&
          (
            !('kycStatus' in incoming()) ||
            ('kycStatus' in existing() && incoming().kycStatus == existing().kycStatus) ||
            (incoming().kycStatus == 'en_attente' && (!('kycStatus' in existing()) || existing().kycStatus in ['non_soumis', 'refuse', '']))
          ) &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'uid', 'email', 'role', 'fullName', 'phone', 'channel', 'avatarUrl',
            'storeName', 'storeCommune', 'storeAddress', 'storeCoordinates',
            'vehicleType', 'gpsCoordinates', 'locationCommune', 'locationAddress',
            'locationLat', 'locationLng', 'locationUpdatedAt',
            'kycStatus', 'kycSubmittedAt',
            'mfaEnabled', 'mfaMethod', 'updatedAt'
          ])
        )
      );
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // 2. Deliveries Collection (/deliveries)
    // -------------------------------------------------------------------------
    match /deliveries/{deliveryId} {
      allow get: if isValidId(deliveryId) && hasVerifiedEmail() && (
        isAdmin() ||
        resource.data.merchantId == request.auth.uid ||
        getCourierId(resource.data) == request.auth.uid ||
        ('clientId' in resource.data && resource.data.clientId == request.auth.uid) ||
        (isKycVerifiedLivreur() && resource.data.status == 'en_attente' && noCourierAssigned(resource.data))
      );

      allow list: if hasVerifiedEmail() && (
        isAdmin() ||
        (isVendeur() && resource.data.merchantId == request.auth.uid) ||
        (isKycVerifiedLivreur() && (
          resource.data.courierId == request.auth.uid ||
          resource.data.status == 'en_attente'
        )) ||
        (isClient() && 'clientId' in resource.data && resource.data.clientId == request.auth.uid)
      );

      allow create: if isValidId(deliveryId) &&
                    hasVerifiedEmail() &&
                    (isVendeur() || isAdmin()) &&
                    isValidDelivery(incoming()) &&
                    (incoming().merchantId == request.auth.uid || isAdmin()) &&
                    incoming().status == 'en_attente' &&
                    noCourierAssigned(incoming()) &&
                    !('podData' in incoming()) &&
                    !('deliveredAt' in incoming()) &&
                    incoming().keys().hasOnly([
                      'id', 'orderId', 'merchantId', 'merchantEmail', 'merchantStoreName',
                      'clientId', 'clientName', 'clientPhone', 'clientNote', 'channel',
                      'pickupLocation', 'dropoffLocation', 'itemDescription', 'itemWeightKg',
                      'itemFormat', 'isFragile', 'itemValueCOD', 'deliveryFee',
                      'totalCustomerPayable', 'status', 'statusNote', 'createdAt',
                      'updatedAt', 'estimatedArrival', 'otpRequired', 'timeline'
                    ]);

      allow update: if isValidId(deliveryId) &&
                    hasVerifiedEmail() &&
                    isValidDelivery(incoming()) &&
                    incoming().id == existing().id &&
                    incoming().merchantId == existing().merchantId &&
                    (
                      isAdmin() ||
                      (
                        // Post-delivery rating by owning vendor (only once, immutable proof & status)
                        isVendeur() &&
                        existing().merchantId == request.auth.uid &&
                        existing().status == 'livree' &&
                        incoming().status == existing().status &&
                        !('courierRating' in existing()) &&
                        'courierRating' in incoming() &&
                        incoming().diff(existing()).affectedKeys().hasOnly(['courierRating', 'updatedAt'])
                      ) ||
                      (
                        !(existing().status in ['livree', 'echec']) &&
                        (
                          // Owning vendor edits while still pending and unassigned
                          (
                            isVendeur() &&
                            existing().merchantId == request.auth.uid &&
                            existing().status == 'en_attente' &&
                            noCourierAssigned(existing()) &&
                            noCourierAssigned(incoming()) &&
                            incoming().status == existing().status &&
                            incoming().diff(existing()).affectedKeys().hasOnly([
                              'clientName', 'clientPhone', 'clientNote', 'itemDescription',
                              'itemWeightKg', 'itemFormat', 'isFragile',
                              'itemValueCOD', 'deliveryFee', 'totalCustomerPayable',
                              'pickupLocation', 'dropoffLocation', 'updatedAt'
                            ])
                          ) ||
                          // KYC-verified courier claiming an open unassigned mission
                          (
                            isKycVerifiedLivreur() &&
                            existing().status == 'en_attente' &&
                            noCourierAssigned(existing()) &&
                            'courierId' in incoming() &&
                            incoming().courierId is string &&
                            incoming().courierId == request.auth.uid &&
                            (!('courier' in incoming()) || (incoming().courier is map && incoming().courier.id == request.auth.uid)) &&
                            incoming().status in ['assignee', 'acceptee'] &&
                            incoming().diff(existing()).affectedKeys().hasOnly([
                              'courierId', 'courierName', 'courier', 'assignedAt', 'status', 'statusNote', 'updatedAt'
                            ])
                          ) ||
                          // Assigned KYC-verified courier advancing pickup/transit/failure (NOT 'livree'!)
                          (
                            isKycVerifiedLivreur() &&
                            hasValidCourierId(existing()) &&
                            getCourierId(existing()) == request.auth.uid &&
                            getCourierId(incoming()) == getCourierId(existing()) &&
                            isCourierStatusTransition(existing().status, incoming().status) &&
                            incoming().diff(existing()).affectedKeys().hasOnly([
                              'status', 'statusNote', 'courierLat', 'courierLng', 'courierLocationUpdatedAt', 'updatedAt'
                            ])
                          ) ||
                          // Assigned KYC-verified courier updating live GPS coordinates during active delivery
                          (
                            isKycVerifiedLivreur() &&
                            hasValidCourierId(existing()) &&
                            getCourierId(existing()) == request.auth.uid &&
                            getCourierId(incoming()) == getCourierId(existing()) &&
                            existing().status in ['assignee', 'acceptee', 'colis_recupere', 'en_cours'] &&
                            incoming().status == existing().status &&
                            incoming().diff(existing()).affectedKeys().hasOnly([
                              'courierLat', 'courierLng', 'courierLocationUpdatedAt', 'updatedAt'
                            ])
                          )
                        )
                      )
                    );

      allow delete: if isAdmin();

      // Private delivery OTP storage (readable/writable ONLY by owning vendor or admin; NEVER readable by couriers)
      match /private/{privateDocId} {
        allow get, list: if isValidId(deliveryId) && hasVerifiedEmail() && (
          isAdmin() ||
          (
            isVendeur() &&
            exists(/databases/$(database)/documents/deliveries/$(deliveryId)) &&
            get(/databases/$(database)/documents/deliveries/$(deliveryId)).data.merchantId == request.auth.uid
          )
        );
        allow create, update: if isValidId(deliveryId) && privateDocId == 'otp' && hasVerifiedEmail() && (
          isAdmin() ||
          (
            isVendeur() &&
            exists(/databases/$(database)/documents/deliveries/$(deliveryId)) &&
            get(/databases/$(database)/documents/deliveries/$(deliveryId)).data.merchantId == request.auth.uid &&
            !(get(/databases/$(database)/documents/deliveries/$(deliveryId)).data.status in ['livree', 'echec']) &&
            incoming().keys().hasAll(['otpCode', 'merchantId']) &&
            incoming().keys().hasOnly(['otpCode', 'merchantId', 'generatedAt', 'updatedAt']) &&
            incoming().merchantId == request.auth.uid &&
            incoming().otpCode is string &&
            incoming().otpCode.matches('^[0-9]{4}$')
          )
        );
        allow delete: if isAdmin();
      }
    }

    // -------------------------------------------------------------------------
    // 3. Isolated Notifications Collection (/notifications)
    //    Business notifications MUST be created by trusted backend/Admin SDK.
    // -------------------------------------------------------------------------
    match /notifications/{notificationId} {
      allow get, list: if hasVerifiedEmail() && (resource.data.recipientId == request.auth.uid || isAdmin());
      allow create: if isAdmin() && isValidId(notificationId) && isValidNotification(incoming());
      allow update: if hasVerifiedEmail() && isValidId(notificationId) && (
        isAdmin() ||
        (
          resource.data.recipientId == request.auth.uid &&
          incoming().recipientId == existing().recipientId &&
          existing().isRead == false &&
          incoming().isRead == true &&
          (!('read' in incoming()) || incoming().read == true) &&
          (!('readAt' in incoming()) || incoming().readAt is number || incoming().readAt is string) &&
          incoming().diff(existing()).affectedKeys().hasOnly(['isRead', 'read', 'readAt', 'updatedAt'])
        )
      );
      allow delete: if hasVerifiedEmail() && isValidId(notificationId) && (resource.data.recipientId == request.auth.uid || isAdmin());
    }

    // -------------------------------------------------------------------------
    // 4. Isolated KYC Dossiers Collection (/kyc)
    // -------------------------------------------------------------------------
    match /kyc/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId) &&
                    hasVerifiedEmail() &&
                    isOwner(userId) &&
                    isValidKYCDossier(incoming()) &&
                    incoming().id == userId &&
                    incoming().userId == request.auth.uid &&
                    (!('courierId' in incoming()) || incoming().courierId == request.auth.uid) &&
                    incoming().status == 'en_attente';
      allow update: if isValidId(userId) && (
        isAdmin() ||
        (
          hasVerifiedEmail() &&
          isOwner(userId) &&
          isValidKYCDossier(incoming()) &&
          (!('status' in existing()) || existing().status in ['refuse', 'non_soumis']) &&
          (!('id' in existing()) || existing().id == '' || incoming().id == existing().id) &&
          incoming().id == userId &&
          (!('userId' in existing()) || existing().userId == '' || incoming().userId == existing().userId) &&
          incoming().userId == request.auth.uid &&
          (!('courierId' in existing()) || existing().courierId == '' || incoming().courierId == existing().courierId) &&
          (!('courierId' in incoming()) || incoming().courierId == request.auth.uid) &&
          (!('role' in existing()) || existing().role == '' || !('role' in incoming()) || incoming().role == existing().role) &&
          incoming().status == 'en_attente' &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'id', 'userId', 'courierId', 'role',
            'lastName', 'firstName', 'fullName', 'phone', 'email',
            'vehicleType', 'vehiclePlate',
            'idType', 'idNumber', 'ifuNumber', 'npi', 'operatingZone',
            'documentPhotoUrl', 'documentStoragePath', 'documentMimeType', 'documentFileName',
            'documents', 'status', 'isApproved',
            'verified', 'submittedAt', 'updatedAt'
          ])
        )
      );
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // 5. Isolated Messaging & Chat (/conversations)
    // -------------------------------------------------------------------------
    match /conversations/{conversationId} {
      allow get, list: if hasVerifiedEmail() && (request.auth.uid in resource.data.participantIds || isAdmin());
      allow create: if hasVerifiedEmail() &&
                    isValidId(conversationId) &&
                    isValidConversation(incoming()) &&
                    request.auth.uid in incoming().participantIds;
      allow update: if hasVerifiedEmail() && isValidId(conversationId) && (
        isAdmin() ||
        (
          request.auth.uid in existing().participantIds &&
          isValidConversation(incoming()) &&
          incoming().participantIds == existing().participantIds &&
          (!('id' in existing()) || incoming().id == existing().id) &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'lastMessage', 'lastMessageAt', 'updatedAt', 'unreadCount', 'orderId', 'title'
          ])
        )
      );
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow get, list: if hasVerifiedEmail() && (
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds || isAdmin()
        );
        allow create: if hasVerifiedEmail() &&
                      isValidId(messageId) &&
                      request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds &&
                      incoming().keys().hasAll(['id', 'senderId', 'text']) &&
                      incoming().keys().hasOnly([
                        'id', 'senderId', 'senderName', 'senderRole', 'text',
                        'attachmentUrl', 'attachmentType', 'createdAt', 'timestamp', 'isRead', 'read'
                      ]) &&
                      isValidId(incoming().id) &&
                      incoming().id == messageId &&
                      incoming().text is string &&
                      incoming().text.size() >= 1 &&
                      incoming().text.size() <= 4000 &&
                      incoming().senderId == request.auth.uid;
        allow update, delete: if isAdmin();
      }
    }

    // -------------------------------------------------------------------------
    // 6. Admin Broadcast Announcements (/announcements)
    // -------------------------------------------------------------------------
    match /announcements/{announcementId} {
      allow read: if isAdmin();
      allow write: if isSuperAdmin();
    }

    // -------------------------------------------------------------------------
    // Helper : Priority Mission Blueprint Validation
    // -------------------------------------------------------------------------
    function isValidPriorityMission(data) {
      return data.keys().hasAll(['id', 'orderId', 'status', 'fee', 'merchantId']) &&
             data.id is string && data.id.size() >= 1 && data.id.size() <= 64 &&
             data.orderId is string && data.orderId.size() >= 1 && data.orderId.size() <= 64 &&
             data.merchantId is string && data.merchantId.size() >= 1 && data.merchantId.size() <= 128 &&
             data.status in ['en_attente', 'assignee', 'acceptee', 'colis_recupere', 'en_cours', 'livree', 'echec'] &&
             data.fee is number && data.fee >= 0 &&
             (!('cod' in data) || (data.cod is number && data.cod >= 0)) &&
             (!('courierId' in data) || (data.courierId is string && data.courierId.size() >= 1 && data.courierId.size() <= 128)) &&
             (!('courierName' in data) || (data.courierName is string && data.courierName.size() <= 128));
    }

    // -------------------------------------------------------------------------
    // 7. Admins Collection (/admins)
    // -------------------------------------------------------------------------
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if isSuperAdmin();
    }

    // -------------------------------------------------------------------------
    // 8. Priority Missions Collection (/priority_missions)
    // -------------------------------------------------------------------------
    match /priority_missions/{missionId} {
      allow get: if isValidId(missionId) && hasVerifiedEmail() && (
        isAdmin() ||
        (isKycVerifiedLivreur() && (
          (resource.data.status == 'en_attente' && noCourierAssigned(resource.data)) ||
          getCourierId(resource.data) == request.auth.uid
        )) ||
        (isVendeur() && ('merchantId' in resource.data && resource.data.merchantId == request.auth.uid))
      );

      allow list: if hasVerifiedEmail() && (
        isAdmin() ||
        (isKycVerifiedLivreur() && (
          resource.data.status == 'en_attente' ||
          resource.data.courierId == request.auth.uid
        )) ||
        (isVendeur() && resource.data.merchantId == request.auth.uid)
      );

      allow create: if isValidId(missionId) &&
                    hasVerifiedEmail() &&
                    isValidPriorityMission(incoming()) &&
                    incoming().status == 'en_attente' &&
                    noCourierAssigned(incoming()) &&
                    ((isVendeur() && incoming().merchantId == request.auth.uid) || isAdmin()) &&
                    incoming().keys().hasOnly([
                      'id', 'orderId', 'merchantId', 'storeName', 'pickupCommune',
                      'dropoffCommune', 'fee', 'cod', 'itemDescription', 'urgency',
                      'status', 'createdAt', 'updatedAt'
                    ]);

      allow update: if isValidId(missionId) &&
                    hasVerifiedEmail() &&
                    isValidPriorityMission(incoming()) &&
                    incoming().id == existing().id &&
                    incoming().orderId == existing().orderId &&
                    (!('merchantId' in existing()) || incoming().merchantId == existing().merchantId) &&
                    (
                      isAdmin() ||
                      (
                        !(existing().status in ['livree', 'echec']) &&
                        (
                          (
                            isVendeur() &&
                            ('merchantId' in existing() && existing().merchantId == request.auth.uid) &&
                            existing().status == 'en_attente' &&
                            noCourierAssigned(existing()) &&
                            noCourierAssigned(incoming()) &&
                            incoming().status == existing().status &&
                            incoming().diff(existing()).affectedKeys().hasOnly([
                              'fee', 'cod', 'pickupCommune', 'dropoffCommune', 'itemDescription',
                              'storeName', 'urgency', 'updatedAt'
                            ])
                          ) ||
                          (
                            isKycVerifiedLivreur() &&
                            existing().status == 'en_attente' &&
                            noCourierAssigned(existing()) &&
                            incoming().status in ['assignee', 'acceptee'] &&
                            'courierId' in incoming() &&
                            incoming().courierId is string &&
                            incoming().courierId == request.auth.uid &&
                            incoming().diff(existing()).affectedKeys().hasOnly([
                              'status', 'courierId', 'courierName', 'assignedAt', 'updatedAt'
                            ])
                          ) ||
                          (
                            isKycVerifiedLivreur() &&
                            hasValidCourierId(existing()) &&
                            getCourierId(existing()) == request.auth.uid &&
                            getCourierId(incoming()) == getCourierId(existing()) &&
                            isCourierStatusTransition(existing().status, incoming().status) &&
                            incoming().diff(existing()).affectedKeys().hasOnly([
                              'status', 'updatedAt'
                            ])
                          )
                        )
                      )
                    );

      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // 9. Connection Test Probe
    // -------------------------------------------------------------------------
    match /test/{testId} {
      allow get: if testId == 'connection';
      allow list, write: if false;
    }

    // -------------------------------------------------------------------------
    // 10. Internal Backend Security Collections (Admin SDK only, zero client access)
    // -------------------------------------------------------------------------
    match /auth_reset_otps/{emailHash} {
      allow read, write: if false;
    }

    match /auth_reset_tokens/{tokenHash} {
      allow read, write: if false;
    }

    match /pod_otp_attempts/{attemptId} {
      allow read, write: if false;
    }

    match /pod_otp_tokens/{tokenHash} {
      allow read, write: if false;
    }

    match /payout_idempotency/{docKeyId} {
      allow read, write: if false;
    }

    match /payout_user_locks/{userId} {
      allow read, write: if false;
    }

    // Internal P1 configuration, email queue, outbox logs & dedup (Admin SDK only, zero client access)
    match /system_config/{configId} {
      allow read, write: if false;
    }

    match /email_logs/{emailId} {
      allow read, write: if false;
    }

    match /email_queue/{jobId} {
      allow read, write: if false;
    }

    match /email_dedup/{dedupId} {
      allow read, write: if false;
    }

    // Financial audit ledger: written exclusively by Admin SDK transactions
    match /wallet_transactions/{txId} {
      allow get, list: if hasVerifiedEmail() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create, update, delete: if false;
    }
  }
}
