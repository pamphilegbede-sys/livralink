rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'fullName', 'phone', 'role']) &&
             data.keys().hasOnly(['uid', 'email', 'fullName', 'phone', 'role', 'avatarUrl', 'storeName', 'vehicleType', 'createdAt', 'updatedAt']) &&
             data.uid == request.auth.uid &&
             data.email is string && data.email.size() <= 128 &&
             data.fullName is string && data.fullName.size() <= 128 &&
             data.phone is string && data.phone.size() <= 32 &&
             (data.role == 'vendeur' || data.role == 'livreur' || data.role == 'admin') &&
             (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 1000)) &&
             (!('storeName' in data) || (data.storeName is string && data.storeName.size() <= 128)) &&
             (!('vehicleType' in data) || (data.vehicleType is string && data.vehicleType.size() <= 64));
    }

    // 1. Users collection: Strictly protected by UID ownership
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // Deny public scraping of user database
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && isValidUser(request.resource.data) &&
                    request.resource.data.uid == resource.data.uid &&
                    request.resource.data.email == resource.data.email;
      allow delete: if false;
    }

    // 2. Deliveries collection
    match /deliveries/{deliveryId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.keys().hasAll(['id', 'clientName', 'clientPhone', 'status', 'deliveryFee']);
      allow update: if isSignedIn();
      allow delete: if false;
    }
  }
}
