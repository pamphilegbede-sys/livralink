rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // 0. Global Safety Net: Default-deny catch-all
    // -------------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Helper Primitives & Attribute-Based Access Control (ABAC)
    // -------------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function hasVerifiedEmail() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-#]+$');
    }

    // Strict Super-Admin & Authorized Admin Check (Fast helpers assume hasVerifiedEmail() already validated)
    function isSuperAdminFast() {
      return request.auth.token.email != null &&
             request.auth.token.email.matches('(?i)^pamphile\\.gbede@gmail\\.com$');
    }

    function isSuperAdmin() {
      return hasVerifiedEmail() && isSuperAdminFast();
    }

    function callerUserExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function callerUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdminFast() {
      return isSuperAdminFast() ||
             exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
             (callerUserExists() && callerUserData().role == 'admin');
    }

    function isAdmin() {
      return hasVerifiedEmail() && isAdminFast();
    }

    function isVendeurFast() {
      return callerUserExists() && callerUserData().role == 'vendeur';
    }

    function isVendeur() {
      return hasVerifiedEmail() && isVendeurFast();
    }

    function isLivreurFast() {
      return callerUserExists() && callerUserData().role == 'livreur';
    }

    function isLivreur() {
      return hasVerifiedEmail() && isLivreurFast();
    }

    function isKycVerifiedLivreurFast() {
      return callerUserExists() &&
             callerUserData().role == 'livreur' &&
             callerUserData().isKycVerified == true;
    }

    function isKycVerifiedLivreur() {
      return hasVerifiedEmail() && isKycVerifiedLivreurFast();
    }

    function isClientFast() {
      return callerUserExists() && callerUserData().role == 'client';
    }

    function isClient() {
      return hasVerifiedEmail() && isClientFast();
    }

    // Safe Courier Assignment Helpers (supports both courierId and courier.id without trusting empty strings)
    function hasValidCourierId(data) {
      return (
        ('courierId' in data && data.courierId is string && data.courierId.size() >= 1 && data.courierId.size() <= 128) ||
        ('courier' in data && data.courier is map && 'id' in data.courier && data.courier.id is string && data.courier.id.size() >= 1 && data.courier.id.size() <= 128)
      );
    }

    function getCourierId(data) {
      return ('courierId' in data && data.courierId is string && data.courierId.size() >= 1)
        ? data.courierId
        : (('courier' in data && data.courier is map && 'id' in data.courier && data.courier.id is string && data.courier.id.size() >= 1)
            ? data.courier.id
            : '');
    }

    function noCourierAssigned(data) {
      return !('courierId' in data) &&
             (!('courier' in data) || !(data.courier is map) || !('id' in data.courier));
    }

    // -------------------------------------------------------------------------
    // User Blueprint Validation (Anti-Privilege Escalation & Legacy-Safe Updates)
    // -------------------------------------------------------------------------
    function isValidUserTypes(data) {
      return data.keys().hasAll(['uid', 'email', 'fullName', 'phone', 'role']) &&
             data.uid == request.auth.uid &&
             data.email is string && data.email.size() >= 5 && data.email.size() <= 128 &&
             data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 128 &&
             data.phone is string && data.phone.size() <= 32 &&
             data.role in ['client', 'vendeur', 'livreur'] &&
             (!('status' in data) || data.status in ['actif', 'en_ligne', 'hors_ligne', 'en_attente_kyc', 'en_course', 'suspendu']) &&
             (!('isKycVerified' in data) || data.isKycVerified is bool) &&
             (!('kycStatus' in data) || data.kycStatus in ['non_soumis', 'en_attente', 'valide', 'refuse']) &&
             (!('preferredRateDiscountPercent' in data) || data.preferredRateDiscountPercent is number) &&
             (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 1000)) &&
             (!('storeName' in data) || (data.storeName is string && data.storeName.size() <= 128)) &&
             (!('storeCommune' in data) || (data.storeCommune is string && data.storeCommune.size() <= 128)) &&
             (!('storeAddress' in data) || (data.storeAddress is string && data.storeAddress.size() <= 256)) &&
             (!('vehicleType' in data) || (data.vehicleType is string && data.vehicleType.size() <= 64)) &&
             (!('gpsCoordinates' in data) || (data.gpsCoordinates is string && data.gpsCoordinates.size() <= 64)) &&
             (!('locationCommune' in data) || (data.locationCommune is string && data.locationCommune.size() <= 128)) &&
             (!('locationAddress' in data) || (data.locationAddress is string && data.locationAddress.size() <= 256)) &&
             (!('locationLat' in data) || (data.locationLat is number)) &&
             (!('locationLng' in data) || (data.locationLng is number)) &&
             (!('locationUpdatedAt' in data) || (data.locationUpdatedAt is string && data.locationUpdatedAt.size() <= 64)) &&
             (!('locationSource' in data) || (data.locationSource is string && data.locationSource in ['browser_gps', 'benin_default', 'live_watch', 'manual'])) &&
             (!('locationAccuracyMeters' in data) || (data.locationAccuracyMeters is number && data.locationAccuracyMeters >= 0)) &&
             (!('isAvailable' in data) || (data.isAvailable is bool)) &&
             (!('preferredCourierId' in data) || data.preferredCourierId == null || (data.preferredCourierId is string && data.preferredCourierId.size() <= 128)) &&
             (!('preferredCourierName' in data) || data.preferredCourierName == null || (data.preferredCourierName is string && data.preferredCourierName.size() <= 128)) &&
             (!('dispatchOfferTimeoutSeconds' in data) || (data.dispatchOfferTimeoutSeconds is number && data.dispatchOfferTimeoutSeconds >= 15 && data.dispatchOfferTimeoutSeconds <= 180)) &&
             (!('mfaEnabled' in data) || (data.mfaEnabled is bool));
    }

    function isValidUserOnCreate(data) {
      return isValidUserTypes(data) &&
             (!('status' in data) || data.status in ['actif', 'en_ligne', 'hors_ligne', 'en_attente_kyc']) &&
             (!('isKycVerified' in data) || data.isKycVerified == false) &&
             (!('kycStatus' in data) || data.kycStatus in ['non_soumis', 'en_attente']) &&
             (!('preferredRateDiscountPercent' in data) || data.preferredRateDiscountPercent == 0) &&
             data.keys().hasOnly([
               'uid', 'email', 'fullName', 'phone', 'role', 'status', 'channel',
               'preferredRateDiscountPercent', 'avatarUrl',
               'storeName', 'storeCommune', 'storeAddress', 'storeCoordinates',
               'vehicleType', 'gpsCoordinates', 'locationCommune', 'locationAddress',
               'locationLat', 'locationLng', 'locationUpdatedAt',
               'locationSource', 'locationAccuracyMeters', 'isAvailable',
               'isKycVerified', 'kycStatus', 'kycRejectionReason', 'kycSubmittedAt',
               'mfaEnabled', 'mfaMethod',
               'createdAt', 'updatedAt'
             ]);
    }

    // -------------------------------------------------------------------------
    // Delivery Blueprint Validation & Strict Status Machine
    // -------------------------------------------------------------------------
    function isValidDelivery(data) {
      return data.keys().hasAll(['id', 'clientName', 'clientPhone', 'status', 'deliveryFee', 'merchantId']) &&
             !('otpCode' in data) &&
             data.id is string && data.id.size() >= 1 && data.id.size() <= 64 &&
             data.clientName is string && data.clientName.size() >= 1 && data.clientName.size() <= 128 &&
             data.clientPhone is string && data.clientPhone.size() <= 32 &&
             data.merchantId is string && data.merchantId.size() >= 1 && data.merchantId.size() <= 128 &&
             data.deliveryFee is number && data.deliveryFee >= 0 &&
             data.status in ['en_attente', 'assignee', 'acceptee', 'colis_recupere', 'en_cours', 'livree', 'echec'] &&
             (!('itemValueCOD' in data) || (data.itemValueCOD is number && data.itemValueCOD >= 0)) &&
             (!('courierId' in data) || (data.courierId is string && data.courierId.size() >= 1 && data.courierId.size() <= 128)) &&
             (!('courierName' in data) || (data.courierName is string && data.courierName.size() <= 128)) &&
             (!('dispatchMode' in data) || data.dispatchMode in ['auto', 'direct']) &&
             (!('dispatchState' in data) || data.dispatchState in ['idle', 'searching', 'offered', 'assigned', 'exhausted']) &&
             (!('preferredCourierId' in data) || data.preferredCourierId == null || (data.preferredCourierId is string && data.preferredCourierId.size() <= 128)) &&
             (!('targetCourierId' in data) || data.targetCourierId == null || (data.targetCourierId is string && data.targetCourierId.size() <= 128)) &&
             (!('offerAttempt' in data) || (data.offerAttempt is number && data.offerAttempt >= 0)) &&
             (!('offerTimeoutSeconds' in data) || (data.offerTimeoutSeconds is number && data.offerTimeoutSeconds >= 15 && data.offerTimeoutSeconds <= 180)) &&
             (!('offerStartedAt' in data) || data.offerStartedAt is number) &&
             (!('offerExpiresAt' in data) || data.offerExpiresAt is number) &&
             (!('distanceKm' in data) || (data.distanceKm is number && data.distanceKm >= 0)) &&
             (!('deliveryType' in data) || data.deliveryType in ['standard', 'express', 'urgent']) &&
             (!('vehicleCategory' in data) || (data.vehicleCategory is string && data.vehicleCategory.size() <= 64)) &&
             (!('promoCode' in data) || data.promoCode == null || (data.promoCode is string && data.promoCode.size() <= 64)) &&
             (!('promoDiscountFCFA' in data) || (data.promoDiscountFCFA is number && data.promoDiscountFCFA >= 0)) &&
             (!('otpRequired' in data) || data.otpRequired is bool);
    }

    function isCourierStatusTransition(oldStatus, newStatus) {
      // Couriers advance through pickup and transit, or report failure.
      // Transition to 'livree' is strictly performed server-side after OTP & Storage verification (or by Admin).
      return ((oldStatus in ['assignee', 'acceptee']) && newStatus in ['colis_recupere', 'echec']) ||
             (oldStatus == 'colis_recupere' && newStatus in ['en_cours', 'echec']) ||
             (oldStatus == 'en_cours' && newStatus == 'echec');
    }

    // -------------------------------------------------------------------------
    // Notification Blueprint Validation
    // -------------------------------------------------------------------------
    function isValidNotification(data) {
      return data.keys().hasAll(['id', 'recipientId', 'senderId', 'title', 'message']) &&
             isValidId(data.id) &&
             isValidId(data.recipientId) &&
             data.senderId is string &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 256 &&
             data.message is string && data.message.size() >= 1 && data.message.size() <= 2048;
    }

    // -------------------------------------------------------------------------
    // KYC Dossier Blueprint Validation
    // -------------------------------------------------------------------------
    function isValidKycSlotMeta(slot, uid) {
      return slot is map &&
             slot.keys().hasAll(['uploaded', 'storagePath', 'docType', 'fileName', 'mimeType', 'uploadedBy', 'uploadedAt']) &&
             slot.uploaded == true &&
             slot.storagePath is string &&
             slot.storagePath.size() >= 10 &&
             slot.storagePath.size() <= 300 &&
             !slot.storagePath.matches('.*\\.\\..*') &&
             slot.storagePath.matches('^kyc/' + uid + '/(id_front|id_back|driving_license_front|driving_license_back|driving_license)/[a-zA-Z0-9_.-]+$') &&
             slot.docType in ['id_front', 'id_back', 'driving_license_front', 'driving_license_back', 'driving_license'] &&
             slot.fileName is string &&
             slot.fileName.size() >= 1 &&
             slot.fileName.size() <= 180 &&
             slot.mimeType in ['image/jpeg', 'image/png', 'image/webp', 'application/pdf'] &&
             slot.uploadedBy == uid &&
             slot.uploadedAt is string &&
             slot.uploadedAt.size() <= 64 &&
             (!('size' in slot) || (slot.size is number && slot.size > 0 && slot.size < 10485760));
    }

    function isValidKycDocumentsMap(docs, uid) {
      return docs is map &&
             (!('idFront' in docs) || isValidKycSlotMeta(docs.idFront, uid)) &&
             (!('idBack' in docs) || isValidKycSlotMeta(docs.idBack, uid)) &&
             (!('drivingLicenseFront' in docs) || isValidKycSlotMeta(docs.drivingLicenseFront, uid)) &&
             (!('drivingLicenseBack' in docs) || isValidKycSlotMeta(docs.drivingLicenseBack, uid)) &&
             (!('drivingLicense' in docs) || isValidKycSlotMeta(docs.drivingLicense, uid));
    }

    function isValidKYCDossier(data) {
      return data.keys().hasAll(['id', 'userId', 'fullName', 'phone', 'status']) &&
             isValidId(data.id) &&
             isValidId(data.userId) &&
             data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 128 &&
             data.phone is string && data.phone.size() <= 32 &&
             data.status in ['en_attente', 'valide', 'refuse'] &&
             (!('documents' in data) || isValidKycDocumentsMap(data.documents, data.userId));
    }

    // -------------------------------------------------------------------------
    // Conversation Blueprint Validation
    // -------------------------------------------------------------------------
    function isValidConversation(data) {
      return data.keys().hasAll(['participantIds']) &&
             data.participantIds is list &&
             data.participantIds.size() >= 2 &&
             data.participantIds.size() <= 10 &&
             data.participantIds[0] is string &&
             data.participantIds[1] is string;
    }

    // -------------------------------------------------------------------------
    // 1. Users Collection (/users)
    // -------------------------------------------------------------------------
    function canOwnerUpdateUserDoc(userId, oldData, newData) {
      let affected = newData.diff(oldData).affectedKeys();
      return isOwner(userId) &&
             isValidUserTypes(newData) &&
             (!('uid' in oldData) || oldData.uid == '' || newData.uid == oldData.uid) &&
             newData.uid == userId &&
             (!('email' in oldData) || oldData.email == '' || newData.email == oldData.email) &&
             (!('email' in affected) || (
               (!('email' in oldData) || oldData.email == '') &&
               request.auth.token.email != null &&
               newData.email == request.auth.token.email
             )) &&
             (!('role' in oldData) || oldData.role == '' || newData.role == oldData.role) &&
             (!('role' in affected) || (
               (!('role' in oldData) || oldData.role == '') &&
               newData.role in ['client', 'vendeur', 'livreur']
             )) &&
             (
               !('status' in newData) ||
               ('status' in oldData && newData.status == oldData.status) ||
               (hasVerifiedEmail() && 'role' in oldData && oldData.role == 'livreur' && (!('status' in oldData) || oldData.status in ['en_ligne', 'hors_ligne', 'actif']) && newData.status in ['en_ligne', 'hors_ligne'])
             ) &&
             (!('isKycVerified' in newData) || ('isKycVerified' in oldData && newData.isKycVerified == oldData.isKycVerified) || (!('isKycVerified' in oldData) && newData.isKycVerified == false)) &&
             (!('preferredRateDiscountPercent' in newData) || ('preferredRateDiscountPercent' in oldData && newData.preferredRateDiscountPercent == oldData.preferredRateDiscountPercent) || (!('preferredRateDiscountPercent' in oldData) && newData.preferredRateDiscountPercent == 0)) &&
             (
               !('kycStatus' in newData) ||
               ('kycStatus' in oldData && newData.kycStatus == oldData.kycStatus) ||
               (newData.kycStatus == 'en_attente' && (!('kycStatus' in oldData) || oldData.kycStatus in ['non_soumis', 'refuse', '']))
             ) &&
             affected.hasOnly([
               'uid', 'email', 'role', 'fullName', 'phone', 'channel', 'avatarUrl',
               'storeName', 'storeCommune', 'storeAddress', 'storeCoordinates',
               'vehicleType', 'gpsCoordinates', 'locationCommune', 'locationAddress',
               'locationLat', 'locationLng', 'locationUpdatedAt',
               'locationSource', 'locationAccuracyMeters', 'status', 'isAvailable',
               'preferredCourierId', 'preferredCourierName', 'dispatchOfferTimeoutSeconds',
               'kycStatus', 'kycSubmittedAt',
               'mfaEnabled', 'mfaMethod', 'updatedAt'
             ]);
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId) && ((isOwner(userId) && isValidUserOnCreate(incoming())) || isAdmin());
      allow update: if isValidId(userId) && (isAdmin() || canOwnerUpdateUserDoc(userId, existing(), incoming()));
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // 2. Deliveries Collection (/deliveries)
    // -------------------------------------------------------------------------
    function canNonAdminUpdateDelivery(oldData, newData) {
      let u = callerUserExists() ? callerUserData() : null;
      let isVendorCaller = u != null && u.role == 'vendeur';
      let isVerifiedCourierCaller = u != null && u.role == 'livreur' && u.isKycVerified == true;
      let oldUnassigned = noCourierAssigned(oldData);
      let oldCourier = getCourierId(oldData);
      let newCourier = getCourierId(newData);
      let diffKeys = newData.diff(oldData).affectedKeys();

      return (
        // Post-delivery rating by owning vendor (only once, immutable proof & status)
        (
          isVendorCaller &&
          oldData.merchantId == request.auth.uid &&
          oldData.status == 'livree' &&
          newData.status == oldData.status &&
          !('courierRating' in oldData) &&
          'courierRating' in newData &&
          diffKeys.hasOnly(['courierRating', 'updatedAt'])
        ) ||
        (
          !(oldData.status in ['livree', 'echec']) &&
          (
            // Owning vendor edits or dispatches while still pending and unassigned
            (
              isVendorCaller &&
              oldData.merchantId == request.auth.uid &&
              oldData.status == 'en_attente' &&
              oldUnassigned &&
              noCourierAssigned(newData) &&
              newData.status == oldData.status &&
              diffKeys.hasOnly([
                'clientName', 'clientPhone', 'clientNote', 'itemDescription',
                'itemWeightKg', 'itemFormat', 'isFragile',
                'itemValueCOD', 'deliveryFee', 'totalCustomerPayable',
                'pickupLocation', 'dropoffLocation', 'statusNote', 'updatedAt',
                'dispatchMode', 'dispatchState', 'preferredCourierId', 'preferredCourierName',
                'targetCourierId', 'targetCourierName', 'targetCourierDistanceKm', 'targetIsPreferred',
                'candidateQueue', 'rejectedCourierIds', 'expiredCourierIds',
                'offerAttempt', 'offerTimeoutSeconds', 'offerStartedAt', 'offerExpiresAt',
                'dispatchFailureReason'
              ])
            ) ||
            // KYC-verified courier claiming an open or targeted unassigned mission
            (
              isVerifiedCourierCaller &&
              oldData.status == 'en_attente' &&
              oldUnassigned &&
              (!('targetCourierId' in oldData) || oldData.targetCourierId == null || oldData.targetCourierId == request.auth.uid) &&
              'courierId' in newData &&
              newData.courierId is string &&
              newData.courierId == request.auth.uid &&
              (!('courier' in newData) || (newData.courier is map && newData.courier.id == request.auth.uid)) &&
              (!('dispatchState' in newData) || newData.dispatchState == 'assigned') &&
              (!('targetCourierId' in newData) || newData.targetCourierId == null) &&
              newData.status in ['assignee', 'acceptee'] &&
              diffKeys.hasOnly([
                'courierId', 'courierName', 'courier', 'assignedAt', 'status', 'statusNote',
                'dispatchState', 'targetCourierId', 'targetCourierName', 'targetCourierDistanceKm', 'targetIsPreferred',
                'updatedAt'
              ])
            ) ||
            // Targeted KYC-verified courier refusing or advancing own offer sequentially
            (
              isVerifiedCourierCaller &&
              oldData.status == 'en_attente' &&
              oldUnassigned &&
              'targetCourierId' in oldData &&
              oldData.targetCourierId == request.auth.uid &&
              noCourierAssigned(newData) &&
              newData.status == 'en_attente' &&
              diffKeys.hasOnly([
                'dispatchState', 'targetCourierId', 'targetCourierName', 'targetCourierDistanceKm', 'targetIsPreferred',
                'candidateQueue', 'rejectedCourierIds', 'expiredCourierIds',
                'offerAttempt', 'offerStartedAt', 'offerExpiresAt', 'dispatchFailureReason', 'statusNote', 'updatedAt'
              ])
            ) ||
            // Assigned KYC-verified courier advancing pickup/transit/failure (NOT 'livree'!)
            (
              isVerifiedCourierCaller &&
              hasValidCourierId(oldData) &&
              oldCourier == request.auth.uid &&
              newCourier == oldCourier &&
              isCourierStatusTransition(oldData.status, newData.status) &&
              diffKeys.hasOnly([
                'status', 'statusNote', 'courierLat', 'courierLng', 'courierLocationUpdatedAt', 'updatedAt'
              ])
            ) ||
            // Assigned KYC-verified courier updating live GPS coordinates during active delivery
            (
              isVerifiedCourierCaller &&
              hasValidCourierId(oldData) &&
              oldCourier == request.auth.uid &&
              newCourier == oldCourier &&
              oldData.status in ['assignee', 'acceptee', 'colis_recupere', 'en_cours'] &&
              newData.status == oldData.status &&
              diffKeys.hasOnly([
                'courierLat', 'courierLng', 'courierLocationUpdatedAt', 'updatedAt'
              ])
            )
          )
        )
      );
    }

    function canVendorReadPrivateOtp(deliveryId) {
      return isVendeurFast() &&
             exists(/databases/$(database)/documents/deliveries/$(deliveryId)) &&
             get(/databases/$(database)/documents/deliveries/$(deliveryId)).data.merchantId == request.auth.uid;
    }

    function canVendorWritePrivateOtp(deliveryId, newData) {
      let parentData = exists(/databases/$(database)/documents/deliveries/$(deliveryId))
        ? get(/databases/$(database)/documents/deliveries/$(deliveryId)).data
        : null;
      return isVendeurFast() &&
             parentData != null &&
             parentData.merchantId == request.auth.uid &&
             !(parentData.status in ['livree', 'echec']) &&
             newData.keys().hasAll(['otpCode', 'merchantId']) &&
             newData.keys().hasOnly(['otpCode', 'merchantId', 'generatedAt', 'updatedAt']) &&
             newData.merchantId == request.auth.uid &&
             newData.otpCode is string &&
             newData.otpCode.matches('^[0-9]{4}$');
    }

    match /deliveries/{deliveryId} {
      allow get: if isValidId(deliveryId) && hasVerifiedEmail() && (
        resource.data.merchantId == request.auth.uid ||
        getCourierId(resource.data) == request.auth.uid ||
        ('clientId' in resource.data && resource.data.clientId == request.auth.uid) ||
        isAdminFast() ||
        (
          resource.data.status == 'en_attente' &&
          noCourierAssigned(resource.data) &&
          ('targetCourierId' in resource.data && resource.data.targetCourierId == request.auth.uid) &&
          isKycVerifiedLivreurFast()
        )
      );

      allow list: if hasVerifiedEmail() && (
        isAdminFast() ||
        (isVendeurFast() && resource.data.merchantId == request.auth.uid) ||
        (isKycVerifiedLivreurFast() && (
          resource.data.courierId == request.auth.uid ||
          resource.data.targetCourierId == request.auth.uid
        )) ||
        (isClientFast() && 'clientId' in resource.data && resource.data.clientId == request.auth.uid)
      );

      allow create: if isValidId(deliveryId) &&
                    hasVerifiedEmail() &&
                    isValidDelivery(incoming()) &&
                    ((incoming().merchantId == request.auth.uid && isVendeurFast()) || isAdminFast()) &&
                    incoming().status == 'en_attente' &&
                    noCourierAssigned(incoming()) &&
                    !('podData' in incoming()) &&
                    !('deliveredAt' in incoming()) &&
                    incoming().keys().hasOnly([
                      'id', 'orderId', 'merchantId', 'merchantEmail', 'merchantStoreName',
                      'clientId', 'clientName', 'clientPhone', 'clientNote', 'channel',
                      'pickupLocation', 'dropoffLocation', 'itemDescription', 'itemWeightKg',
                      'itemFormat', 'isFragile', 'itemValueCOD', 'deliveryFee',
                      'totalCustomerPayable', 'status', 'statusNote', 'createdAt',
                      'updatedAt', 'estimatedArrival', 'otpRequired', 'timeline',
                      'dispatchMode', 'dispatchState', 'preferredCourierId', 'preferredCourierName',
                      'targetCourierId', 'targetCourierName', 'targetCourierDistanceKm', 'targetIsPreferred',
                      'candidateQueue', 'rejectedCourierIds', 'expiredCourierIds',
                      'offerAttempt', 'offerTimeoutSeconds', 'offerStartedAt', 'offerExpiresAt',
                      'dispatchFailureReason', 'distanceKm', 'deliveryType', 'vehicleCategory',
                      'promoCode', 'promoDiscountFCFA', 'pricingSnapshot', 'remunerationSnapshot', 'commissionSnapshot'
                    ]);

      allow update: if isValidId(deliveryId) &&
                    hasVerifiedEmail() &&
                    isValidDelivery(incoming()) &&
                    incoming().id == existing().id &&
                    incoming().merchantId == existing().merchantId &&
                    (isAdminFast() || canNonAdminUpdateDelivery(existing(), incoming()));

      allow delete: if isAdmin();

      // Private delivery OTP storage (readable/writable ONLY by owning vendor or admin; NEVER readable by couriers)
      match /private/{privateDocId} {
        allow get, list: if isValidId(deliveryId) && hasVerifiedEmail() && (
          isAdminFast() || canVendorReadPrivateOtp(deliveryId)
        );
        allow create, update: if isValidId(deliveryId) && privateDocId == 'otp' && hasVerifiedEmail() && (
          isAdminFast() || canVendorWritePrivateOtp(deliveryId, incoming())
        );
        allow delete: if isAdmin();
      }
    }

    // -------------------------------------------------------------------------
    // 3. Isolated Notifications Collection (/notifications)
    //    Business notifications MUST be created by trusted backend/Admin SDK.
    // -------------------------------------------------------------------------
    match /notifications/{notificationId} {
      allow get, list: if hasVerifiedEmail() && (resource.data.recipientId == request.auth.uid || isAdminFast());
      allow create: if isAdmin() && isValidId(notificationId) && isValidNotification(incoming());
      allow update: if hasVerifiedEmail() && isValidId(notificationId) && (
        isAdminFast() ||
        (
          resource.data.recipientId == request.auth.uid &&
          incoming().recipientId == existing().recipientId &&
          existing().isRead == false &&
          incoming().isRead == true &&
          (!('read' in incoming()) || incoming().read == true) &&
          (!('readAt' in incoming()) || incoming().readAt is number || incoming().readAt is string) &&
          incoming().diff(existing()).affectedKeys().hasOnly(['isRead', 'read', 'readAt', 'updatedAt'])
        )
      );
      allow delete: if hasVerifiedEmail() && isValidId(notificationId) && (resource.data.recipientId == request.auth.uid || isAdminFast());
    }

    // -------------------------------------------------------------------------
    // 4. Isolated KYC Dossiers Collection (/kyc)
    // -------------------------------------------------------------------------
    match /kyc/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId) &&
                    hasVerifiedEmail() &&
                    isOwner(userId) &&
                    isValidKYCDossier(incoming()) &&
                    !('aiAnalysis' in incoming()) &&
                    !('reviewedAt' in incoming()) &&
                    !('reviewedBy' in incoming()) &&
                    (!('isApproved' in incoming()) || incoming().isApproved == false) &&
                    (!('verified' in incoming()) || incoming().verified == false) &&
                    incoming().id == userId &&
                    incoming().userId == request.auth.uid &&
                    (!('courierId' in incoming()) || incoming().courierId == request.auth.uid) &&
                    incoming().status == 'en_attente';
      allow update: if isValidId(userId) && (
        isAdmin() ||
        (
          hasVerifiedEmail() &&
          isOwner(userId) &&
          isValidKYCDossier(incoming()) &&
          (!('isApproved' in incoming()) || incoming().isApproved == false) &&
          (!('verified' in incoming()) || incoming().verified == false) &&
          (!('status' in existing()) || existing().status in ['refuse', 'non_soumis']) &&
          (!('id' in existing()) || existing().id == '' || incoming().id == existing().id) &&
          incoming().id == userId &&
          (!('userId' in existing()) || existing().userId == '' || incoming().userId == existing().userId) &&
          incoming().userId == request.auth.uid &&
          (!('courierId' in existing()) || existing().courierId == '' || incoming().courierId == existing().courierId) &&
          (!('courierId' in incoming()) || incoming().courierId == request.auth.uid) &&
          (!('role' in existing()) || existing().role == '' || !('role' in incoming()) || incoming().role == existing().role) &&
          incoming().status == 'en_attente' &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'id', 'userId', 'courierId', 'role',
            'lastName', 'firstName', 'fullName', 'phone', 'email',
            'vehicleType', 'vehiclePlate',
            'idType', 'idNumber', 'ifuNumber', 'npi', 'operatingZone',
            'documentPhotoUrl', 'documentStoragePath', 'documentMimeType', 'documentFileName',
            'documents', 'status', 'isApproved',
            'verified', 'submittedAt', 'updatedAt'
          ])
        )
      );
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // 5. Isolated Messaging & Chat (/conversations)
    // -------------------------------------------------------------------------
    match /conversations/{conversationId} {
      allow get, list: if hasVerifiedEmail() && (request.auth.uid in resource.data.participantIds || isAdmin());
      allow create: if hasVerifiedEmail() &&
                    isValidId(conversationId) &&
                    isValidConversation(incoming()) &&
                    request.auth.uid in incoming().participantIds;
      allow update: if hasVerifiedEmail() && isValidId(conversationId) && (
        isAdmin() ||
        (
          request.auth.uid in existing().participantIds &&
          isValidConversation(incoming()) &&
          incoming().participantIds == existing().participantIds &&
          (!('id' in existing()) || incoming().id == existing().id) &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'lastMessage', 'lastMessageAt', 'updatedAt', 'unreadCount', 'orderId', 'title'
          ])
        )
      );
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow get, list: if hasVerifiedEmail() && (
          isAdminFast() ||
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds
        );
        allow create: if hasVerifiedEmail() &&
                      isValidId(messageId) &&
                      request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds &&
                      incoming().keys().hasAll(['id', 'senderId', 'text']) &&
                      incoming().keys().hasOnly([
                        'id', 'senderId', 'senderName', 'senderRole', 'text',
                        'attachmentUrl', 'attachmentType', 'createdAt', 'timestamp', 'isRead', 'read'
                      ]) &&
                      isValidId(incoming().id) &&
                      incoming().id == messageId &&
                      incoming().text is string &&
                      incoming().text.size() >= 1 &&
                      incoming().text.size() <= 4000 &&
                      incoming().senderId == request.auth.uid;
        allow update, delete: if isAdmin();
      }
    }

    // -------------------------------------------------------------------------
    // 6. Admin Broadcast Announcements (/announcements)
    // -------------------------------------------------------------------------
    match /announcements/{announcementId} {
      allow read: if isAdmin();
      allow write: if isSuperAdmin();
    }

    // -------------------------------------------------------------------------
    // Helper : Priority Mission Blueprint Validation
    // -------------------------------------------------------------------------
    function isValidPriorityMission(data) {
      return data.keys().hasAll(['id', 'orderId', 'status', 'fee', 'merchantId']) &&
             data.id is string && data.id.size() >= 1 && data.id.size() <= 64 &&
             data.orderId is string && data.orderId.size() >= 1 && data.orderId.size() <= 64 &&
             data.merchantId is string && data.merchantId.size() >= 1 && data.merchantId.size() <= 128 &&
             data.status in ['en_attente', 'assignee', 'acceptee', 'colis_recupere', 'en_cours', 'livree', 'echec'] &&
             data.fee is number && data.fee >= 0 &&
             (!('cod' in data) || (data.cod is number && data.cod >= 0)) &&
             (!('courierId' in data) || (data.courierId is string && data.courierId.size() >= 1 && data.courierId.size() <= 128)) &&
             (!('courierName' in data) || (data.courierName is string && data.courierName.size() <= 128));
    }

    // -------------------------------------------------------------------------
    // 7. Admins Collection (/admins)
    // -------------------------------------------------------------------------
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if isSuperAdmin();
    }

    // -------------------------------------------------------------------------
    // 8. Priority Missions Collection (/priority_missions)
    // -------------------------------------------------------------------------
    function canNonAdminUpdateMission(oldData, newData) {
      let u = callerUserExists() ? callerUserData() : null;
      let isVendorCaller = u != null && u.role == 'vendeur';
      let isVerifiedCourierCaller = u != null && u.role == 'livreur' && u.isKycVerified == true;
      let oldUnassigned = noCourierAssigned(oldData);
      let oldCourier = getCourierId(oldData);
      let newCourier = getCourierId(newData);
      let diffKeys = newData.diff(oldData).affectedKeys();

      return !(oldData.status in ['livree', 'echec']) && (
        (
          isVendorCaller &&
          ('merchantId' in oldData && oldData.merchantId == request.auth.uid) &&
          oldData.status == 'en_attente' &&
          oldUnassigned &&
          noCourierAssigned(newData) &&
          newData.status == oldData.status &&
          diffKeys.hasOnly([
            'fee', 'cod', 'pickupCommune', 'dropoffCommune', 'itemDescription',
            'storeName', 'urgency',
            'dispatchMode', 'dispatchState', 'preferredCourierId', 'preferredCourierName',
            'targetCourierId', 'targetCourierName', 'targetCourierDistanceKm', 'targetIsPreferred',
            'offerAttempt', 'offerTimeoutSeconds', 'offerStartedAt', 'offerExpiresAt',
            'updatedAt'
          ])
        ) ||
        (
          isVerifiedCourierCaller &&
          oldData.status == 'en_attente' &&
          oldUnassigned &&
          (!('targetCourierId' in oldData) || oldData.targetCourierId == null || oldData.targetCourierId == request.auth.uid) &&
          newData.status in ['assignee', 'acceptee'] &&
          'courierId' in newData &&
          newData.courierId is string &&
          newData.courierId == request.auth.uid &&
          (!('dispatchState' in newData) || newData.dispatchState == 'assigned') &&
          (!('targetCourierId' in newData) || newData.targetCourierId == null) &&
          diffKeys.hasOnly([
            'status', 'courierId', 'courierName', 'assignedAt',
            'dispatchState', 'targetCourierId', 'targetCourierName', 'targetCourierDistanceKm', 'targetIsPreferred',
            'updatedAt'
          ])
        ) ||
        (
          isVerifiedCourierCaller &&
          oldData.status == 'en_attente' &&
          oldUnassigned &&
          'targetCourierId' in oldData &&
          oldData.targetCourierId == request.auth.uid &&
          noCourierAssigned(newData) &&
          newData.status == 'en_attente' &&
          diffKeys.hasOnly([
            'dispatchState', 'targetCourierId', 'targetCourierName', 'targetCourierDistanceKm', 'targetIsPreferred',
            'offerAttempt', 'offerStartedAt', 'offerExpiresAt', 'updatedAt'
          ])
        ) ||
        (
          isVerifiedCourierCaller &&
          hasValidCourierId(oldData) &&
          oldCourier == request.auth.uid &&
          newCourier == oldCourier &&
          isCourierStatusTransition(oldData.status, newData.status) &&
          diffKeys.hasOnly([
            'status', 'updatedAt'
          ])
        )
      );
    }

    match /priority_missions/{missionId} {
      allow get: if isValidId(missionId) && hasVerifiedEmail() && (
        isAdminFast() ||
        (isKycVerifiedLivreurFast() && (
          (resource.data.status == 'en_attente' && noCourierAssigned(resource.data) && 'targetCourierId' in resource.data && resource.data.targetCourierId == request.auth.uid) ||
          getCourierId(resource.data) == request.auth.uid
        )) ||
        ('merchantId' in resource.data && resource.data.merchantId == request.auth.uid && isVendeurFast())
      );

      allow list: if hasVerifiedEmail() && (
        isAdminFast() ||
        (isKycVerifiedLivreurFast() && (
          resource.data.targetCourierId == request.auth.uid ||
          resource.data.courierId == request.auth.uid
        )) ||
        (isVendeurFast() && resource.data.merchantId == request.auth.uid)
      );

      allow create: if isValidId(missionId) &&
                    hasVerifiedEmail() &&
                    isValidPriorityMission(incoming()) &&
                    incoming().status == 'en_attente' &&
                    noCourierAssigned(incoming()) &&
                    ((incoming().merchantId == request.auth.uid && isVendeurFast()) || isAdminFast()) &&
                    incoming().keys().hasOnly([
                      'id', 'orderId', 'merchantId', 'storeName', 'pickupCommune',
                      'dropoffCommune', 'fee', 'cod', 'itemDescription', 'urgency',
                      'dispatchMode', 'dispatchState', 'preferredCourierId', 'preferredCourierName',
                      'targetCourierId', 'targetCourierName', 'targetCourierDistanceKm', 'targetIsPreferred',
                      'offerAttempt', 'offerTimeoutSeconds', 'offerStartedAt', 'offerExpiresAt',
                      'status', 'createdAt', 'updatedAt'
                    ]);

      allow update: if isValidId(missionId) &&
                    hasVerifiedEmail() &&
                    isValidPriorityMission(incoming()) &&
                    incoming().id == existing().id &&
                    incoming().orderId == existing().orderId &&
                    (!('merchantId' in existing()) || incoming().merchantId == existing().merchantId) &&
                    (isAdminFast() || canNonAdminUpdateMission(existing(), incoming()));

      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // 9. Connection Test Probe
    // -------------------------------------------------------------------------
    match /test/{testId} {
      allow get: if testId == 'connection';
      allow list, write: if false;
    }

    // -------------------------------------------------------------------------
    // 10. Internal Backend Security Collections (Admin SDK only, zero client access)
    // -------------------------------------------------------------------------
    match /auth_reset_otps/{emailHash} {
      allow read, write: if false;
    }

    match /auth_reset_tokens/{tokenHash} {
      allow read, write: if false;
    }

    match /pod_otp_attempts/{attemptId} {
      allow read, write: if false;
    }

    match /pod_otp_tokens/{tokenHash} {
      allow read, write: if false;
    }

    match /payout_idempotency/{docKeyId} {
      allow read, write: if false;
    }

    match /payout_user_locks/{userId} {
      allow read, write: if false;
    }

    // Internal P1 configuration, email queue, outbox logs & dedup (Admin SDK only, zero client access)
    match /system_config/{configId} {
      allow read, write: if false;
    }

    match /email_logs/{emailId} {
      allow read, write: if false;
    }

    match /email_queue/{jobId} {
      allow read, write: if false;
    }

    match /email_dedup/{dedupId} {
      allow read, write: if false;
    }

    match /ai_usage_guards/{guardId} {
      allow read, write: if false;
    }

    match /system_backups/{backupId} {
      allow read, write: if false;
    }

    match /admin_audit_logs/{logId} {
      allow read, write: if false;
    }

    match /refunds/{refundId} {
      allow read, write: if false;
    }

    match /disputes/{disputeId} {
      allow read, write: if false;
    }

    // Financial audit ledger: written exclusively by Admin SDK transactions
    match /wallet_transactions/{txId} {
      allow get, list: if hasVerifiedEmail() && (resource.data.uid == request.auth.uid || isAdminFast());
      allow create, update, delete: if false;
    }
  }
}
