# ==============================================================================
# LIVRALINK — FICHIER D'EXEMPLE DES VARIABLES D'ENVIRONNEMENT (AUCUN SECRET RÉEL)
# ==============================================================================

# 1. URL PUBLIQUE CANONIQUE (Backend + SEO + Liens de réinitialisation)
APP_URL="https://livralink.oxy-dev.cc"
# PUBLIC_SITE_URL="https://livralink.oxy-dev.cc"
# APP_PUBLIC_URL="https://livralink.oxy-dev.cc"

# 2. GOOGLE MAPS PLATFORM (Clé frontend restreinte par domaine HTTP dans Google Cloud)
VITE_GOOGLE_MAPS_API_KEY="replace-with-restricted-google-maps-browser-key"

# 3. FIREBASE CLIENT WEB (Valeurs publiques d'identification du projet Web)
VITE_FIREBASE_API_KEY="replace-with-firebase-web-api-key"
VITE_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project-id.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="your-messaging-sender-id"
VITE_FIREBASE_APP_ID="your-web-app-id"
VITE_FIREBASE_MEASUREMENT_ID=""

# 4. FIREBASE ADMIN SDK & BASE FIRESTORE NOMMÉE (Côté serveur uniquement - CONFIDENTIEL)
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_DATABASE_ID="ai-studio-livralink-f9d2844b-bf6d-492f-9504-2721bd1820b6"
# FIRESTORE_DATABASE_ID="ai-studio-livralink-f9d2844b-bf6d-492f-9504-2721bd1820b6"
# Requis hors GCP/ADC (ex: Render, VPS) ; sur Cloud Run / App Hosting, ADC est utilisé si vide :
# FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"...","private_key":"..."}'

# 5. SECRETS CRYPTOGRAPHIQUES SERVEUR (OBLIGATOIRES EN PRODUCTION, min 32 caractères aléatoires)
# OTP_SECRET_SALT et POD_OTP_HMAC_SECRET servent à signer les jetons OTP & POD HMAC-SHA256
OTP_SECRET_SALT="replace-with-64-hex-random-secret-generated-via-openssl"
POD_OTP_HMAC_SECRET="replace-with-64-hex-random-secret-generated-via-openssl"
# Réservé au chiffrement applicatif des métadonnées/e-mails si activé
EMAIL_ENCRYPTION_SECRET="replace-with-64-hex-random-secret-generated-via-openssl"

# 6. RELAIS SMTP GMAIL (Côté serveur uniquement - CONFIDENTIEL)
# Utiliser un mot de passe d'application Google 16 caractères (Compte Google > Sécurité > Validation en 2 étapes)
GMAIL_SMTP_HOST="smtp.gmail.com"
GMAIL_SMTP_PORT=587
GMAIL_SMTP_USER="your-sender@gmail.com"
GMAIL_SMTP_PASS="replace-with-16-char-google-app-password"
GMAIL_SMTP_FROM="\"LivraLink Sécurité\" <your-sender@gmail.com>"
# Alias compatibles App Hosting / Render :
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_USER="your-sender@gmail.com"
# SMTP_PASS="replace-with-16-char-google-app-password"
# SMTP_FROM="\"LivraLink\" <your-sender@gmail.com>"

# 7. GEMINI API (Optionnel, côté serveur uniquement si fonctionnalités IA activées)
GEMINI_API_KEY="replace-with-server-gemini-api-key-if-used"
