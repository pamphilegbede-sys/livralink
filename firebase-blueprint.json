{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Données de profil utilisateur pour les marchands et livreurs LivraLink.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$", "description": "Identifiant unique Firebase Auth (UID)" },
        "email": { "type": "string", "format": "email", "maxLength": 128, "description": "Adresse email du compte" },
        "fullName": { "type": "string", "maxLength": 128, "description": "Nom complet ou nom du responsable" },
        "phone": { "type": "string", "maxLength": 32, "description": "Numéro de téléphone / WhatsApp" },
        "role": { "type": "string", "enum": ["client", "vendeur", "livreur", "admin"], "description": "Rôle métier" },
        "avatarUrl": { "type": "string", "maxLength": 1000, "description": "Photo de profil ou logo" },
        "storeName": { "type": "string", "maxLength": 128, "description": "Nom commercial du vendeur" },
        "storeCommune": { "type": "string", "maxLength": 128, "description": "Commune du magasin" },
        "storeAddress": { "type": "string", "maxLength": 256, "description": "Adresse physique du magasin" },
        "vehicleType": { "type": "string", "maxLength": 64, "description": "Type de véhicule du livreur" },
        "gpsCoordinates": { "type": "string", "maxLength": 64, "description": "Coordonnées GPS détectées" },
        "locationCommune": { "type": "string", "maxLength": 128, "description": "Commune détectée" },
        "locationAddress": { "type": "string", "maxLength": 256, "description": "Adresse détectée" },
        "locationLat": { "type": "number", "description": "Latitude GPS détectée" },
        "locationLng": { "type": "number", "description": "Longitude GPS détectée" },
        "locationUpdatedAt": { "type": "string", "maxLength": 64, "description": "Horodatage de la détection de position" },
        "locationSource": { "type": "string", "enum": ["browser_gps", "benin_default", "live_watch", "manual"], "description": "Source de la coordonnée GPS" },
        "locationAccuracyMeters": { "type": "number", "description": "Précision GPS en mètres" },
        "isAvailable": { "type": "boolean", "description": "Disponibilité en temps réel du livreur" },
        "preferredCourierId": { "type": "string", "maxLength": 128, "description": "Livreur préféré configuré par le vendeur" },
        "preferredCourierName": { "type": "string", "maxLength": 128, "description": "Nom du livreur préféré" },
        "dispatchOfferTimeoutSeconds": { "type": "number", "description": "Délai de réponse par livreur en secondes" },
        "isKycVerified": { "type": "boolean", "description": "Statut d'accréditation KYC" },
        "kycStatus": { "type": "string", "enum": ["non_soumis", "en_attente", "valide", "refuse"], "description": "État du dossier KYC" },
        "kycRejectionReason": { "type": "string", "maxLength": 512, "description": "Motif de refus du dossier KYC" },
        "kycSubmittedAt": { "type": "string", "maxLength": 64, "description": "Date de soumission du dossier KYC" },
        "createdAt": { "type": "string", "maxLength": 64, "description": "Horodatage de création du compte" },
        "updatedAt": { "type": "string", "maxLength": 64, "description": "Horodatage de mise à jour" }
      },
      "required": ["uid", "email", "fullName", "phone", "role"]
    },
    "DeliveryOrder": {
      "title": "DeliveryOrder",
      "description": "Commande et expédition de livraison urbaine.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64, "description": "Code unique de la course (ex: #LL-4192)" },
        "clientName": { "type": "string", "maxLength": 128, "description": "Nom du destinataire" },
        "clientPhone": { "type": "string", "maxLength": 32, "description": "Téléphone du destinataire" },
        "status": { "type": "string", "enum": ["en_attente", "assignee", "acceptee", "colis_recupere", "en_cours", "livree", "echec"], "description": "Statut opérationnel" },
        "deliveryFee": { "type": "number", "description": "Tarif de livraison calculé" },
        "itemValueCOD": { "type": "number", "description": "Montant paiement à la livraison (COD)" },
        "merchantId": { "type": "string", "maxLength": 128, "description": "UID du vendeur propriétaire" },
        "courierId": { "type": "string", "maxLength": 128, "description": "UID du coursier assigné" },
        "dispatchMode": { "type": "string", "enum": ["auto", "direct"], "description": "Mode d'attribution" },
        "dispatchState": { "type": "string", "enum": ["idle", "searching", "offered", "assigned", "exhausted"], "description": "État du dispatching séquentiel" },
        "preferredCourierId": { "type": "string", "maxLength": 128, "description": "UID du livreur préféré" },
        "targetCourierId": { "type": "string", "maxLength": 128, "description": "UID du livreur actuellement sollicité" },
        "offerAttempt": { "type": "number", "description": "Numéro de tentative d'offre séquentielle" },
        "offerTimeoutSeconds": { "type": "number", "description": "Délai maximal de réponse en secondes" },
        "offerStartedAt": { "type": "number", "description": "Horodatage début d'offre (ms)" },
        "offerExpiresAt": { "type": "number", "description": "Horodatage expiration d'offre (ms)" },
        "createdAt": { "type": "string", "maxLength": 64, "description": "Date de création de la course" },
        "updatedAt": { "type": "string", "maxLength": 64, "description": "Date de dernière modification" }
      },
      "required": ["id", "clientName", "clientPhone", "status", "deliveryFee", "merchantId"]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Compte administrateur habilité avec privilèges élevés.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128, "description": "UID administrateur" },
        "email": { "type": "string", "format": "email", "maxLength": 128, "description": "Email administrateur" },
        "level": { "type": "string", "enum": ["super_admin", "operator"], "description": "Niveau de permission" },
        "createdAt": { "type": "string", "maxLength": 64, "description": "Date d'habilitation" }
      },
      "required": ["uid", "email", "level"]
    },
    "KYCDossier": {
      "title": "KYCDossier",
      "description": "Dossier d'accréditation et de contrôle identité KYC.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "description": "Identifiant du dossier (UID de l'utilisateur)" },
        "userId": { "type": "string", "maxLength": 128, "description": "UID de l'utilisateur propriétaire" },
        "courierId": { "type": "string", "maxLength": 128, "description": "UID du coursier propriétaire" },
        "lastName": { "type": "string", "maxLength": 64, "description": "Nom de famille" },
        "firstName": { "type": "string", "maxLength": 64, "description": "Prénoms" },
        "fullName": { "type": "string", "maxLength": 128, "description": "Nom complet de l'utilisateur" },
        "phone": { "type": "string", "maxLength": 32, "description": "Numéro de téléphone" },
        "email": { "type": "string", "format": "email", "maxLength": 128, "description": "E-mail de l'utilisateur" },
        "idType": { "type": "string", "enum": ["CIP", "CNI", "PASSPORT"], "description": "Type de pièce d'identité" },
        "npi": { "type": "string", "maxLength": 64, "description": "Numéro Personnel d'Identification" },
        "idNumber": { "type": "string", "maxLength": 64, "description": "Numéro de CNI ou Passeport" },
        "ifuNumber": { "type": "string", "maxLength": 64, "description": "Numéro IFU optionnel" },
        "operatingZone": { "type": "string", "maxLength": 128, "description": "Zone d'activité principale" },
        "vehicleType": { "type": "string", "maxLength": 64, "description": "Type d'engin ou véhicule" },
        "vehiclePlate": { "type": "string", "maxLength": 32, "description": "Plaque d'immatriculation" },
        "documentStoragePath": { "type": "string", "maxLength": 256, "description": "Chemin privé Firebase Storage principal ou historique (accès authentifié uniquement)" },
        "documentMimeType": { "type": "string", "maxLength": 64, "description": "Type MIME réel du justificatif (image/* ou application/pdf)" },
        "documentFileName": { "type": "string", "maxLength": 128, "description": "Nom de fichier du justificatif" },
        "documents": {
          "type": "object",
          "description": "Métadonnées des pièces KYC (idFront et idBack obligatoires ; drivingLicenseFront et drivingLicenseBack facultatifs)",
          "properties": {
            "idFront": { "type": "object", "description": "Recto de la pièce d'identité (obligatoire)" },
            "idBack": { "type": "object", "description": "Verso de la pièce d'identité (obligatoire)" },
            "drivingLicenseFront": { "type": "object", "description": "Recto du permis de conduire (facultatif)" },
            "drivingLicenseBack": { "type": "object", "description": "Verso du permis de conduire (facultatif)" }
          }
        },
        "aiAnalysis": {
          "type": "object",
          "description": "Rapport structuré d'analyse documentaire assistée par Google Gemini (écriture serveur Admin SDK uniquement, aucune validation/rejet automatique)",
          "properties": {
            "status": { "type": "string", "enum": ["not_started", "processing", "completed", "failed"] },
            "provider": { "type": "string", "enum": ["gemini"] },
            "model": { "type": "string", "maxLength": 128 },
            "analyzedAt": { "type": "string", "maxLength": 64 },
            "startedAt": { "type": "string", "maxLength": 64 },
            "requestedBy": { "type": "string", "maxLength": 128 },
            "summary": { "type": "string", "maxLength": 2000 },
            "extractedData": { "type": "object" },
            "documents": { "type": "object" },
            "crossChecks": { "type": "array" },
            "warnings": { "type": "array" },
            "issues": { "type": "array" },
            "recommendations": { "type": "array" },
            "error": { "type": "string", "maxLength": 512 },
            "errorCode": { "type": "string", "maxLength": 64 },
            "usage": { "type": "object" }
          }
        },
        "status": { "type": "string", "enum": ["en_attente", "valide", "refuse"], "description": "Statut d'instruction" },
        "submittedAt": { "type": "string", "maxLength": 64, "description": "Date de soumission" },
        "reviewedAt": { "type": "string", "maxLength": 64, "description": "Date d'instruction par l'administrateur" },
        "rejectionReason": { "type": "string", "maxLength": 512, "description": "Motif du refus" }
      },
      "required": ["id", "userId", "fullName", "phone", "status"]
    },
    "AppNotification": {
      "title": "AppNotification",
      "description": "Notification personnelle distribuée à un utilisateur spécifique.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "description": "Identifiant unique de notification" },
        "recipientId": { "type": "string", "maxLength": 128, "description": "UID de l'utilisateur destinataire" },
        "type": { "type": "string", "description": "Type opérationnel de notification" },
        "title": { "type": "string", "maxLength": 256, "description": "Titre de la notification" },
        "message": { "type": "string", "maxLength": 2048, "description": "Contenu de la notification" },
        "category": { "type": "string", "maxLength": 64, "description": "Catégorie métier" },
        "orderId": { "type": "string", "maxLength": 64, "description": "Référence optionnelle vers une commande" },
        "isRead": { "type": "boolean", "description": "Statut de lecture par le destinataire" },
        "timestamp": { "type": "string", "maxLength": 64, "description": "Horodatage de création" }
      },
      "required": ["id", "recipientId", "title", "message"]
    },
    "Conversation": {
      "title": "Conversation",
      "description": "Fil de discussion privé entre vendeurs et livreurs.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "description": "Identifiant unique de la conversation" },
        "participantIds": { "type": "array", "description": "Liste explicite des UIDs des participants" },
        "orderId": { "type": "string", "maxLength": 64, "description": "Identifiant de la commande liée" },
        "creatorId": { "type": "string", "maxLength": 128, "description": "UID de l'initiateur" },
        "contactName": { "type": "string", "maxLength": 128, "description": "Nom du correspondant" },
        "lastMessage": { "type": "string", "maxLength": 1000, "description": "Dernier extrait de message" },
        "updatedAt": { "type": "string", "maxLength": 64, "description": "Horodatage de dernière activité" }
      },
      "required": ["id", "participantIds", "creatorId"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Message individuel dans une conversation isolée.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "description": "Identifiant unique du message" },
        "conversationId": { "type": "string", "maxLength": 128, "description": "Identifiant de la conversation résidente" },
        "participantIds": { "type": "array", "description": "Miroir des participants pour l'isolation" },
        "senderId": { "type": "string", "maxLength": 128, "description": "UID de l'expéditeur" },
        "senderName": { "type": "string", "maxLength": 128, "description": "Nom affiché de l'expéditeur" },
        "text": { "type": "string", "maxLength": 2048, "description": "Texte du message" },
        "createdAt": { "type": "string", "maxLength": 64, "description": "Horodatage d'envoi" },
        "isRead": { "type": "boolean", "description": "Statut d'accusé de lecture" }
      },
      "required": ["id", "conversationId", "senderId", "text"]
    },
    "BroadcastAnnouncement": {
      "title": "BroadcastAnnouncement",
      "description": "Annonce et communication générale administrée par la direction.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "description": "Identifiant unique de la diffusion" },
        "title": { "type": "string", "maxLength": 256, "description": "Sujet ou titre de l'annonce" },
        "message": { "type": "string", "maxLength": 4096, "description": "Corps du message officiel" },
        "audience": { "type": "string", "enum": ["tous", "vendeurs", "livreurs", "admins", "individuel"], "description": "Portée de l'audience" },
        "channel": { "type": "string", "enum": ["notification", "email", "both"], "description": "Canal d'expédition" },
        "targetUid": { "type": "string", "maxLength": 128, "description": "UID de la cible en cas de message individuel" },
        "recipientCount": { "type": "number", "description": "Nombre total de destinataires touchés" },
        "sentAt": { "type": "string", "maxLength": 64, "description": "Horodatage de la diffusion" },
        "sentBy": { "type": "string", "maxLength": 128, "description": "Identifiant de l'administrateur émetteur" },
        "status": { "type": "string", "enum": ["complete", "partial", "failed"], "description": "Statut de distribution" }
      },
      "required": ["id", "title", "message", "audience", "channel", "sentBy"]
    },
    "PriorityMission": {
      "title": "PriorityMission",
      "description": "Mission prioritaire disponible pour les livreurs accrédités KYC.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "orderId": { "type": "string", "maxLength": 64 },
        "merchantId": { "type": "string", "maxLength": 128 },
        "courierId": { "type": "string", "maxLength": 128 },
        "targetCourierId": { "type": "string", "maxLength": 128 },
        "dispatchState": { "type": "string", "enum": ["idle", "searching", "offered", "assigned", "exhausted"] },
        "offerExpiresAt": { "type": "number" },
        "status": { "type": "string", "enum": ["en_attente", "assignee", "acceptee", "colis_recupere", "en_cours", "livree", "echec"] },
        "fee": { "type": "number" },
        "cod": { "type": "number" }
      },
      "required": ["id", "orderId", "merchantId", "status", "fee"]
    },
    "WalletTransaction": {
      "title": "WalletTransaction",
      "description": "Grand livre immuable des transactions financières écrit exclusivement par le serveur.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "amountFCFA": { "type": "number" },
        "status": { "type": "string" }
      },
      "required": ["uid", "amountFCFA", "status"]
    },
    "SystemSmtpConfig": {
      "title": "SystemSmtpConfig",
      "description": "Configuration SMTP partagée inter-instances (mot de passe chiffré AES-256-GCM uniquement, accès serveur exclusif).",
      "type": "object",
      "properties": {
        "host": { "type": "string" },
        "port": { "type": "number" },
        "user": { "type": "string" },
        "from": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["host", "port", "user", "from"]
    },
    "EmailQueueJob": {
      "title": "EmailQueueJob",
      "description": "Tâche persistante d'expédition d'e-mail avec verrou d'exécution distribué (accès serveur exclusif).",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "to": { "type": "string", "format": "email" },
        "subject": { "type": "string" },
        "status": { "type": "string", "enum": ["queued", "processing", "sent", "failed"] },
        "retryCount": { "type": "number" }
      },
      "required": ["id", "to", "subject", "status", "retryCount"]
    },
    "EmailLogRecord": {
      "title": "EmailLogRecord",
      "description": "Journal des e-mails expédiés ou mis en file d'attente (accès serveur exclusif).",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "to": { "type": "string", "format": "email" },
        "subject": { "type": "string" },
        "status": { "type": "string", "enum": ["sent", "queued", "failed"] },
        "sentAt": { "type": "string" }
      },
      "required": ["id", "to", "subject", "sentAt"]
    },
    "EmailDedupKey": {
      "title": "EmailDedupKey",
      "description": "Clé de déduplication distribuée anti-doublon d'e-mails (accès serveur exclusif).",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "dedupKey": { "type": "string" },
        "expiresAt": { "type": "number" }
      },
      "required": ["id", "dedupKey", "expiresAt"]
    },
    "AiUsageGuard": {
      "title": "AiUsageGuard",
      "description": "Verrou de concurrence, quota journalier et coupe-circuit distribué pour les appels serveur Gemini KYC (accès serveur Admin SDK exclusif).",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "processing": { "type": "boolean" },
        "leaseExpiresAt": { "type": "number" },
        "lastRequestedAt": { "type": "number" },
        "count": { "type": "number" },
        "estimatedCostEur": { "type": "number" },
        "consecutiveFailures": { "type": "number" },
        "openUntilMs": { "type": "number" }
      }
    },
    "SystemBackup": {
      "title": "SystemBackup",
      "description": "Instantané système persistant vérifié par empreinte SHA-256 (accès serveur Admin SDK exclusif).",
      "type": "object",
      "properties": {
        "backupId": { "type": "string", "maxLength": 128 },
        "timestamp": { "type": "string", "maxLength": 64 },
        "checksum": { "type": "string", "maxLength": 128 },
        "mode": { "type": "string", "enum": ["payload_snapshot", "operational_collections"] },
        "sizeBytes": { "type": "number" },
        "payloadJson": { "type": "string" },
        "createdByUid": { "type": "string", "maxLength": 128 },
        "createdByEmail": { "type": "string", "maxLength": 128 }
      },
      "required": ["backupId", "timestamp", "checksum", "mode", "payloadJson"]
    },
    "AdminAuditLog": {
      "title": "AdminAuditLog",
      "description": "Journal d'audit immuable des actions d'administration (accès serveur Admin SDK exclusif).",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "adminUid": { "type": "string", "maxLength": 128 },
        "adminEmail": { "type": "string", "maxLength": 128 },
        "adminRole": { "type": "string", "maxLength": 64 },
        "category": { "type": "string", "maxLength": 64 },
        "action": { "type": "string", "maxLength": 128 },
        "targetType": { "type": "string", "maxLength": 64 },
        "targetId": { "type": "string", "maxLength": 128 },
        "timestamp": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "adminUid", "adminEmail", "category", "action", "timestamp"]
    },
    "DeliveryDispute": {
      "title": "DeliveryDispute",
      "description": "Réclamation ou litige formel lié à une course (accès serveur Admin SDK exclusif).",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "orderId": { "type": "string", "maxLength": 64 },
        "category": { "type": "string" },
        "priority": { "type": "string" },
        "status": { "type": "string", "enum": ["ouvert", "en_analyse", "resolu", "clos"] },
        "subject": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 1000 }
      },
      "required": ["id", "orderId", "status", "subject"]
    },
    "RefundRecord": {
      "title": "RefundRecord",
      "description": "Remboursement transactionnel idempotent (accès serveur Admin SDK exclusif).",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "idempotencyKey": { "type": "string", "maxLength": 128 },
        "targetUid": { "type": "string", "maxLength": 128 },
        "amountFCFA": { "type": "number" },
        "reason": { "type": "string", "maxLength": 500 },
        "status": { "type": "string" }
      },
      "required": ["id", "targetUid", "amountFCFA", "reason", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Profils isolés et confidentiels des utilisateurs."
    },
    "/deliveries/{deliveryId}": {
      "schema": "DeliveryOrder",
      "description": "Commandes et expéditions gérées (création et montants financiers certifiés exclusivement par le serveur Admin SDK via POST /api/deliveries)."
    },
    "/priority_missions/{missionId}": {
      "schema": "PriorityMission",
      "description": "Missions prioritaires publiées pour les coursiers vérifiés KYC (création atomique serveur Admin SDK exclusivement)."
    },
    "/admins/{adminId}": {
      "schema": "AdminUser",
      "description": "Administrateurs racine du système."
    },
    "/kyc/{userId}": {
      "schema": "KYCDossier",
      "description": "Dossiers d'accréditation KYC strictement confidentiels."
    },
    "/notifications/{notificationId}": {
      "schema": "AppNotification",
      "description": "Notifications personnelles filtrées par UID destinataire."
    },
    "/conversations/{conversationId}": {
      "schema": "Conversation",
      "description": "Conversations de messagerie restreintes aux participants."
    },
    "/conversations/{conversationId}/messages/{messageId}": {
      "schema": "ChatMessage",
      "description": "Messages isolés de discussion privée."
    },
    "/announcements/{announcementId}": {
      "schema": "BroadcastAnnouncement",
      "description": "Historique des annonces officielles diffusées."
    },
    "/wallet_transactions/{txId}": {
      "schema": "WalletTransaction",
      "description": "Journal financier immuable écrit par le backend Admin SDK."
    },
    "/system_config/{configId}": {
      "schema": "SystemSmtpConfig",
      "description": "Configuration système chiffrée partagée entre instances (accès serveur exclusif)."
    },
    "/email_logs/{emailId}": {
      "schema": "EmailLogRecord",
      "description": "Historique centralisé des e-mails (accès serveur exclusif)."
    },
    "/email_queue/{jobId}": {
      "schema": "EmailQueueJob",
      "description": "File d'attente persistante et verrouillée des e-mails (accès serveur exclusif)."
    },
