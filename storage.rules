rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Default deny all access
    match /{allPaths=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() &&
             'email_verified' in request.auth.token &&
             request.auth.token.email_verified == true;
    }

    function isMasterAdminEmail() {
      return isVerifiedUser() &&
             'email' in request.auth.token &&
             request.auth.token.email != null &&
             request.auth.token.email.matches('(?i)^pamphile\\.gbede@gmail\\.com$');
    }

    // Pure Firebase Auth + Custom Claims admin check (zero cross-service named-DB Firestore calls,
    // because Cloud Storage Security Rules in production only support the (default) Firestore database).
    function isAdmin() {
      return isMasterAdminEmail() || (
        isVerifiedUser() && (
          ('admin' in request.auth.token && request.auth.token.admin == true) ||
          ('role' in request.auth.token && request.auth.token.role == 'admin')
        )
      );
    }

    function isKycLocked() {
      return 'kycLocked' in request.auth.token &&
             request.auth.token.kycLocked == true;
    }

    function hasValidUploaderMetadata() {
      return request.resource != null &&
             request.resource.metadata != null &&
             'uploadedBy' in request.resource.metadata &&
             request.resource.metadata.uploadedBy == request.auth.uid;
    }

    function isSafeFileName(fileName) {
      return fileName is string &&
             fileName.size() >= 1 &&
             fileName.size() <= 160 &&
             !fileName.matches('.*\\.\\..*');
    }

    // 1. User Profile Avatars: /avatars/{userId}/{fileName}
    match /avatars/{userId}/{fileName} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
                            && isSafeFileName(userId)
                            && isSafeFileName(fileName)
                            && (request.auth.uid == userId || isAdmin())
                            && request.resource != null
                            && request.resource.size > 0
                            && request.resource.size < 5 * 1024 * 1024
                            && request.resource.contentType is string
                            && request.resource.contentType in [
                              'image/jpeg',
                              'image/png',
                              'image/webp',
                              'image/gif'
                            ]
                            && hasValidUploaderMetadata();
      allow delete: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    // 2. KYC Identification Documents: /kyc/{userId}/{fileName}
    //    - Strictly private: readable only by verified owner or Admin (plus server Admin SDK /api/kyc/document)
    //    - Create only (immutable for couriers): verified owner, < 10 MB, JPG/PNG/WebP/PDF, uploadedBy == uid
    //    - No overwrite, update, or deletion allowed by couriers once uploaded
    match /kyc/{userId}/{fileName} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isVerifiedUser()
                    && isSafeFileName(userId)
                    && isSafeFileName(fileName)
                    && request.resource != null
                    && request.resource.size > 0
                    && request.resource.size < 10 * 1024 * 1024
                    && request.resource.contentType is string
                    && request.resource.contentType in [
                      'image/jpeg',
                      'image/png',
                      'image/webp',
                      'application/pdf'
                    ]
                    && hasValidUploaderMetadata()
                    && (
                      (
                        request.auth.uid == userId &&
                        !isKycLocked()
                      ) ||
                      isAdmin()
                    );
      allow update, delete: if isAdmin();
    }

    // 3. Proof of Delivery (POD) Photos & Signatures: /pod/{orderId}/{fileName}
    //    - Strict participant isolation cannot be verified in Storage Rules because LivraLink uses
    //      a named Firestore database (cross-service firestore.get() only supports (default)).
    //    - Direct client Storage read/write is restricted strictly to Admins; verified couriers,
    //      vendors, and recipients upload and read POD proofs through server-verified Admin SDK
    //      routes (/api/pod/upload & /api/pod/media).
    match /pod/{orderId}/{fileName} {
      allow read: if isAdmin();
      allow create: if isAdmin()
                    && isSafeFileName(orderId)
                    && isSafeFileName(fileName)
                    && request.resource != null
                    && request.resource.size > 0
                    && request.resource.size < 10 * 1024 * 1024
                    && request.resource.contentType is string
                    && request.resource.contentType in [
                      'image/jpeg',
                      'image/png',
                      'image/webp'
                    ]
                    && hasValidUploaderMetadata();
      allow update, delete: if isAdmin();
    }

    // 4. Chat attachments / Media: /chat/{conversationId}/{fileName}
    //    - Strict conversation participant isolation enforced server-side against named Firestore DB.
    //    - Direct client Storage read/write is restricted strictly to Admins; conversation members
    //      upload and read media through server-verified Admin SDK routes (/api/chat/upload & /api/chat/media).
    match /chat/{conversationId}/{fileName} {
      allow read: if isAdmin();
      allow create: if isAdmin()
                    && isSafeFileName(conversationId)
                    && isSafeFileName(fileName)
                    && request.resource != null
                    && request.resource.size > 0
                    && request.resource.size < 15 * 1024 * 1024
                    && request.resource.contentType is string
                    && (
                      request.resource.contentType in [
                        'image/jpeg',
                        'image/png',
                        'image/webp',
                        'application/pdf'
                      ] ||
                      request.resource.contentType.matches('audio/.*')
                    )
                    && hasValidUploaderMetadata();
      allow update, delete: if isAdmin();
    }
  }
}
