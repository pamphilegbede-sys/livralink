{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "start": "tsx server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "tsx --test test-vendor-delivery-isolation.test.ts src/tests/deliveryIsolation.test.ts src/tests/kycAndNotifications.test.ts src/tests/serverApi.test.ts src/tests/pdfAndFlows.test.ts src/tests/p0Security.test.ts",
    "test:rules:firestore": "firebase emulators:exec --only firestore --project ai-studio-livralink-security-test \"npx tsx --test firestore.rules.test.ts\"",
    "test:rules:storage": "firebase emulators:exec --only firestore,storage --project ai-studio-livralink-storage-test \"npx tsx --test storage.rules.test.ts\"",
    "migrate:dry-run": "tsx scripts/migrate-p0-legacy.ts --dry-run"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/compression": "^1.8.1",
    "@types/nodemailer": "^8.0.2",
    "@vis.gl/react-google-maps": "^1.10.1",
    "@vitejs/plugin-react": "^6.1.1",
    "compression": "^1.8.2",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "nodemailer": "^10.0.13",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tsx": "^4.21.0",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^2.0.0",
    "tailwindcss": "^4.3.3",
    "autoprefixer": "^10.4.21",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/express": "^4.17.21",
    "@types/google.maps": "^3.66.6",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
